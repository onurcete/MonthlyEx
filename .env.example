# Local development (SQLite) or Remote Turso LibSQL (libsql://your-db.turso.io)
DATABASE_URL=file:data/monthlyex.db
# Required for remote Turso database:
# DATABASE_AUTH_TOKEN=

# Optional password protection for Vercel / public deployments:
# APP_PASSWORD=

# Server-side OpenAI document analysis. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
